[Unit]
Description=DRAX Backend — Flask API
After=network.target

[Service]
Type=exec
User=www-data
WorkingDirectory=/var/www/draxis/backend
ExecStart=/usr/local/bin/gunicorn -w 4 -k gevent -b 127.0.0.1:5000 wsgi:app
Restart=always
RestartSec=5
Environment=FLASK_ENV=production
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
